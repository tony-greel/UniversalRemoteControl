<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniversalRemoteControl" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="AcRemote.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/ac_toggle_background_tint</item>
        <item name="android:textColor">@color/ac_toggle_text_color</item>
        <item name="strokeColor">@color/ac_toggle_stroke_color</item>
    </style>
</resources>
